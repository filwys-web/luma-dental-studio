# Dodaj te zmienne do Vercel -> Project -> Settings -> Environment Variables.
# Nigdy nie wpisuj prawdziwego klucza do tego pliku ani do GitHuba.
RESEND_API_KEY=re_TUTAJ_TYLKO_LOKALNY_TEST
# Zweryfikuj domenę nadawczą w Resend; nie używaj domeny odbiorcy, jeśli nie jest Twoja.
RESEND_FROM_EMAIL=formularz@twojadomena.pl
# Może to być Gmail/Outlook lub firmowy e-mail recepcji.
CONTACT_TO_EMAIL=recepcja@twojadomena.pl